# Copia este archivo a .env y rellena los valores.

# Clave del agente de playit.gg (https://playit.gg -> Add Agent -> Docker)
PLAYIT_SECRET_KEY=

# Tu nick de Minecraft para tener permisos de operador (varios separados por coma)
MC_OPS=

# RAM para el servidor. Deja al menos 2 GB libres para el sistema.
MC_MEMORY=8G
